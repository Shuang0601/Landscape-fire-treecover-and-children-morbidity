# Function to create individual plots
create_stratified_plot <- function(data, outcome_name,
                                   show_x_title = FALSE,
                                   show_y_title = FALSE,
                                   show_legend = FALSE) {
  
  result_out <- data[data$outcome == outcome_name, ]
  
  p <- ggplot(result_out, aes(x = x, y = RR, color = group, fill = group)) +
    geom_ribbon(
      aes(ymin = RRlow, ymax = RRhigh),
      alpha = 0.20,
      colour = NA
    ) +
    geom_line(linewidth = 0.8) +
    geom_hline(
      yintercept = 1.000,
      color = "grey40",
      linetype = "dashed",
      linewidth = 0.6
    ) +
    ggtitle(outcome_name) +
    xlab(
      if (show_x_title) {
        expression("Wildfire-specific PM"[2.5] * " (" * mu * "g/m"^3 * ")")
      } else {
        NULL
      }
    ) +
    ylab(if (show_y_title) "Relative Risk (95% CI)" else NULL) +
    theme_bw() +
    theme(
      plot.title = element_text(
        size = 15,
        face = "bold",
        family = "serif",
        hjust = 0
      ),
      axis.text = element_text(
        size = 12,
        colour = "black",
        family = "serif"
      ),
      axis.title.x = element_text(
        size = 13,
        colour = "black",
        family = "serif"
      ),
      axis.title.y = element_text(
        size = 13,
        colour = "black",
        family = "serif"
      ),
      legend.position = if (show_legend) "bottom" else "none",
      legend.direction = "vertical",
      legend.box = "vertical",
      legend.title = element_text(
        size = 11,
        family = "serif",
        hjust = 0.5),
      legend.text = element_text(
        size = 10.5,
        family = "serif"),
      legend.key.size = unit(0.45, "cm"),
      legend.spacing.y = unit(0.05, "cm"),
      legend.margin = margin(t = 0, r = 0, b = 0, l = 0),
      legend.box.margin = margin(t = 14, r = 0, b = 0, l = 0),
      panel.grid.major = element_line(color = "grey90", linewidth = 0.3),
      panel.grid.minor = element_line(color = "grey95", linewidth = 0.2),
      panel.border = element_rect(
        color = "black",
        fill = NA,
        linewidth = 0.5
      ),
      plot.margin = margin(6, 7, 6, 7, "pt")
    ) +
    labs(
      color = "Tree cover",
      fill = "Tree cover"
    ) +
scale_color_manual(
  values = c(
    "M1" = "#d95f02",
    "M2" = "#1b9e77"
  ),
  breaks = c("M2", "M1"),
  labels = c(
    "M2" = "High",
    "M1" = "Low"
  )
) +
scale_fill_manual(
  values = c(
    "M1" = "#d95f02",
    "M2" = "#1b9e77"
  ),
  breaks = c("M2", "M1"),
  labels = c(
    "M2" = "High",
    "M1" = "Low"
  )
) +
guides(
  color = guide_legend(
    ncol = 1,
    byrow = TRUE,
    title.position = "top"
  ),
  fill = guide_legend(
    ncol = 1,
    byrow = TRUE,
    title.position = "top"
  )
)
  
  return(p)
}


