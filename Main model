outcomes <- c("All",
                   "All_CVD","All_Resp","All_Infectious","All_Digestive",
                   "All_Diabetes","All_Cancer","All_Nervous","All_Renal")

### begin meta

group.list <- c("tree_cut2_all","tree_cut3_all")

### Pool RR by subgroups
result_RR_subgroup <- data.frame()
result_coef_subgroup <- data.frame()

for (i in seq_along(outcomes)) {
  outcome <- outcomes[i]
  result_mid <- airpar_eAsia_for_RR1[airpar_eAsia_for_RR1$outcome == outcome,]
  
  result_RR <- data.frame()
  result_coef <- data.frame()
  
  for (j in seq_along(group.list)) {
    group <- group.list[j]
    

    if (!(group %in% colnames(result_mid))) {
      warning(paste("Skipping", group, "because it does not exist in the dataset"))
      next  
    }
    
    class_list <- unique(na.omit(result_mid[[group]]))
    
    for (ii in seq_along(class_list)) {
      class <- as.character(class_list[ii])
      mid1 <- result_mid[result_mid[[group]] == class,]
      
      if (nrow(mid1) == 0) {
        warning(paste("Skipping class", class, "in group", group, "due to empty subset"))
        next  
      }

      coef_mid <- as.matrix(mid1[,grep("coef", names(mid1))])
      vcov_mid <- as.matrix(mid1[,grep("vcov", names(mid1))])
      
      if (nrow(coef_mid) == 0 || ncol(vcov_mid) == 0) {
        warning(paste("Skipping class", class, "due to missing coef or vcov"))
        next
      }
      
      model_mid <- mixmeta(coef_mid, vcov_mid, method="reml")
      
      air_mean_mid <- meanexposure$value
      
      bvar_mid <- crossbasis(as.numeric(air_mean_mid), lag = lagday,
                             argvar = list(fun = "lin"),
                             arglag = list(fun = 'ns'))
      
      # PREDICT THE ASSOCIATION
      cp_mid = crosspred(bvar_mid, coef=coef(model_mid), vcov=vcov(model_mid), model.link="log",
                       at=10, cen = 0)
      #cp_mid <- crosspred(bvar_mid, coef = coef(model_mid), vcov = vcov(model_mid),
       #                   model.link = "log", at = 1, cen = 0)
      
      data_RR <- data.frame(pollutant = "fire_PM25",
                            outcome = outcome,
                            subgroup = group,
                            class = class,
                            x = as.numeric(unname(cp_mid$predvar)),
                            RR = unname(cp_mid$allRRfit),
                            RRlow = unname(cp_mid$allRRlow),
                            RRhigh = unname(cp_mid$allRRhigh))
      
      # STORE PARAMETERS FOR AIRPAR
      ncoef <- length(coef(cp_mid))
      par <- c(coef(cp_mid), vechMat(vcov(cp_mid)))
      names(par) <- c(paste0("coef", seq(ncoef)),
                      paste0("vcov", seq(ncoef*(ncoef+1)/2)))
      
      data_coef <- data.frame(pollutant = "fire_PM25",
                              outcome = outcome,
                              subgroup = group,
                              class = class,
                              t(par))
      
      result_RR <- bind_rows(result_RR, data_RR)
      result_coef <- bind_rows(result_coef, data_coef)
    }
    
  }
  
  result_RR_subgroup <- bind_rows(result_RR_subgroup, result_RR)
  result_coef_subgroup <- bind_rows(result_coef_subgroup, result_coef)
  
  print(i)
}

