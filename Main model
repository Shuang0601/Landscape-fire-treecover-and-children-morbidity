### calculate the SE and coef for P for difference
result_RR_subgroup$Se <- (log(result_RR_subgroup$RRhigh) - log(result_RR_subgroup$RRlow)) / (2 * 1.96)
result_RR_subgroup$Beta <- log(result_RR_subgroup$RR)

### calculate P for difference

group.list <- c("tree_cut2_all")

result_meta_subgroup1 <- data.frame()

for (i in seq_along(outcomes)) {
  outcome <- outcomes[i]
  result_mid <- result_RR_subgroup[result_RR_subgroup$outcome == outcome,]
  data_meta_mid<- data.frame()
   for (j in seq_along(group.list)) {
    group <- group.list[j]

    result_mid_mid <- result_mid[result_mid$subgroup == group,]
    z_low = abs(c(zval = (result_mid_mid[result_mid_mid$class == 'M1',]$Beta - result_mid_mid[result_mid_mid$class == 'M2',]$Beta)/sqrt(result_mid_mid[result_mid_mid$class == 'M1',]$Se^2 + result_mid_mid[result_mid_mid$class == 'M2',]$Se^2)))
    P_low = round(2*(1-pnorm(z_low)),6)

   
    data_meta = data.frame(pollutant = "fire_PM25",
                         outcome = outcomes[i],
                         subgroup = group,
                         class = c("M1","M2"),
                      
                         x = as.numeric(unname(cp_mid$predvar)),

                         P_val = c("Ref",P_low))

    data_meta_mid <- bind_rows(data_meta_mid,data_meta)
  }
  
  result_meta_subgroup1 <- bind_rows(result_meta_subgroup1,data_meta_mid)
  print(i)
}


