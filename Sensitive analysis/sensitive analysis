load('...../meanexposure.Rdata')

outcomes <- c("All")
# Pool ER relationship

## Pool ER
lagday <- 01

airpar_eAsia_for_ER$Country <- substr(airpar_eAsia_for_ER$cityname,1,3)

result_tree_RR <- data.frame()

for (outcome in outcomes) {
  for (grp in c("M1","M2")) {
    mid1 <- airpar_eAsia_for_ER %>%
      dplyr::filter(.data$outcome == !!outcome,
                    .data$tree_cut2_all == !!grp)
    
    if(nrow(mid1) == 0) next
    
    coef_mid <- as.matrix(mid1[,grep("coef", names(mid1))])
    vcov_mid <- as.matrix(mid1[,grep("vcov", names(mid1))])
    
    model_mid <- mixmeta(coef_mid~1, vcov_mid, method="reml")
    
    air_mean_mid <- meanexposure$value
   
     #knots_mid <- quantile(air_mean_mid, c(25,75)/100, na.rm = TRUE)
    knots_mid = quantile(air_mean_mid,c(10,90)/100,na.rm = T)
    #knots_mid = quantile(air_mean_mid,c(20,80)/100,na.rm = T)
    
    
    bvar_mid <- crossbasis(as.numeric(air_mean_mid), lag = lagday,
                           argvar = list(fun="ns", knots = knots_mid),
                           arglag = list(fun="ns"))
    
    cp_mid <- crosspred(bvar_mid,
                        coef = coef(model_mid), vcov = vcov(model_mid),
                        model.link = "log",
                        at = seq(min(air_mean_mid), max(air_mean_mid), 0.01),
                        cen = min(air_mean_mid))
    
    data_mid <- data.frame(
      pollutant = "fire_PM25",
      outcome = outcome,
      group = grp, 
      x = as.numeric(unname(cp_mid$predvar)),
      RR = unname(cp_mid$allRRfit),
      RRlow = unname(cp_mid$allRRlow),
      RRhigh = unname(cp_mid$allRRhigh)
    )
    
    result_tree_RR <- rbind(result_tree_RR, data_mid)
    
    print(paste(outcome, grp))
  }
}

