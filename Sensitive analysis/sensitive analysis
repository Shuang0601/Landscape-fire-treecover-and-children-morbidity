###the following is the sensitivity code for ER changing the location of knots, from 25,75  to 20,80 and 10,90

####10-90####

data <- readRDS(r"(.....\Hospitalization.rds)")

data_list <- split(data, data$LocIDLarge)

outcomes <- c("All",
                   "All_CVD","All_Resp","All_Infectious","All_Digestive",
                   "All_Diabetes","All_Cancer","All_Nervous","All_Renal")


lagday <- 1
df_lag <- 1

## try parallel
numCores <- 20
registerDoParallel(numCores)
t1 <- Sys.time()

airpar_eAsia_for_ER <- foreach(i = seq_along(data_list), .packages = c("dlnm",'tidyverse','splines','mixmeta','lubridate','data.table')) %dopar% {
  
  dat_mid = data_list[[i]]
  dat_mid$time = 1:nrow(dat_mid)
  dat_mid$dow = weekdays(dat_mid$date)
  df_time = round(nrow(dat_mid)/365.25)*7
  dat_mid$rhum_mvavg = frollmean(dat_mid$RH,8)
  
  arg.temp <- list(fun = "ns", knots = quantile(dat_mid$tmean, c(10, 75, 90) / 100, na.rm = TRUE), intercept = TRUE)
  
  cb.temp <- crossbasis(dat_mid$tmean, lag = 21, argvar = arg.temp,
                         arglag = list(knots = logknots(21, 3)))
  

  airpar_eAsia_for_ER <- data.frame()
  for (outcome in outcomes) {
    if(outcome %in% names(dat_mid) & mean(dat_mid[[outcome]]) >= 0.01){
      
      dat_mid$x = dat_mid[["fire_PM25"]]
      dat_mid$y = dat_mid[[outcome]] 
      
      knots_air = quantile(dat_mid$x,c(10,90)/100,na.rm = T)
    
    
    try_crossbasis = try(crossbasis(dat_mid$x,lag = lagday, argvar=list(fun="ns", knots = knots_air),
                               arglag=list(fun='ns')))
    
    if (class(try_crossbasis)[1] =="try-error"){next}
    
    cb_air = crossbasis(dat_mid$x,lag = lagday, argvar=list(fun="ns", knots = knots_air),
                        arglag=list(fun='ns'))
    
    # cb_air = onebasis(dat_mid$x, fun = "ns", knots = knots_mid)
    

      formula_mid = as.formula(paste0('y ~ cb_air + dow + ns(time,df=',df_time,') + cb.temp + ns(rhum_mvavg, df = 3)'))
      
      
      try_model = try(glm(formula_mid,data = dat_mid,family=quasipoisson))
      if (class(try_model)[1] =="try-error"){next}
      
      model =glm(formula_mid,data = dat_mid,family=quasipoisson)
      
      try_crosspred = try(crosspred(cb_air,model,cen= min(dat_mid$x,na.rm = T),by = 0.1))
      if (class(try_crosspred)[1] =="try-error"){next}
      
      mid1 = crosspred(cb_air,model,cen= min(dat_mid$x,na.rm = T),by = 0.1)
    
      # STORE PARAMETERS FOR AIRPAR
      ncoef = length(coef(mid1))
      par = c(coef(mid1), vechMat(vcov(mid1)))
      names(par) = c(paste0("coef", seq(ncoef)),
                     paste0("vcov", seq(ncoef*(ncoef+1)/2)))
      
      
      airpar_eAsia_for_ER = bind_rows(airpar_eAsia_for_ER, data.frame(cityname = unique(dat_mid$LocIDLarge),
                                                                      pollutant = 'fire_PM25',outcome = outcome,maxlag = lagday,t(par)))
    }else{airpar_eAsia_for_ER = bind_rows(airpar_eAsia_for_ER, data.frame(cityname = unique(dat_mid$LocIDLarge),pollutant = 'fire_PM25',outcome = outcome,maxlag = lagday))}
    
  }
  
  return(airpar_eAsia_for_ER)
}
stopImplicitCluster()
t2 <- Sys.time()
t2-t1

length(airpar_eAsia_for_ER)
airpar_eAsia_for_ER <- bind_rows(airpar_eAsia_for_ER)
airpar_eAsia_for_ER1 <- airpar_eAsia_for_ER[!is.na(airpar_eAsia_for_ER$coef1),]
length(unique(airpar_eAsia_for_ER1$cityname))

save(airpar_eAsia_for_ER1, file = '/resultP1_ER_lag01_all_1090.Rdata')

